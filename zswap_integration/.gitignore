# Build outputs (regenerable via harness/scripts/build_impl.sh)
harness/build/

# Deterministic corpus (regenerable via harness/scripts/gen_corpus.py)
harness/corpus/*.bin
harness/corpus/manifest.csv

# Public corpus (e.g. Silesia) used by the real-kernel benchmark; fetched
# locally, not tracked.
harness/public_corpus/

# Python caches
harness/scripts/__pycache__/

# Generated benchmark results and profiling output. All machine-generated and
# regenerable by the benchmark harness, so intentionally NOT tracked.
harness/results/
harness/profiles/

# Kernel module build artifacts (regenerated by `make` in module/)
module/*.o
module/*.ko
module/*.mod
module/*.mod.c
module/.*.cmd
module/modules.order
module/Module.symvers
